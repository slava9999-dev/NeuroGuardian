# NeuroAgent Core - Environment Variables

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-key-here

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS - allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://neuro-guardian.vercel.app

# Security
API_SECRET_KEY=your-secret-key-for-jwt-here

# Logging
LOG_LEVEL=INFO
