{
  "name": "NeuroGUARDIAN User Notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "trigger-1",
      "name": "Every 12 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -800,
        400
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "apiBaseUrl",
              "value": "={{ $env.API_URL }}",
              "type": "string"
            },
            {
              "id": "id-2",
              "name": "cronSecret",
              "value": "={{ $env.CRON_SECRET }}",
              "type": "string"
            },
            {
              "id": "id-3",
              "name": "telegramBotToken",
              "value": "={{ $env.TELEGRAM_BOT_TOKEN }}",
              "type": "string"
            },
            {
              "id": "id-4",
              "name": "adminChatId",
              "value": "={{ $env.ADMIN_CHAT_ID }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "config-1",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -600,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=get-system-metrics",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "api-1",
      "name": "Get Expiring Subscriptions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -400,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.metrics.subscriptions.expiring_soon.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Has Expiring Subscriptions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -200,
        400
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "metrics.subscriptions.expiring_soon",
        "include": "noOtherFields"
      },
      "id": "split-1",
      "name": "Split Users",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const user = $input.item.json;\nconst expiresAt = new Date(user.expires_at);\nconst now = new Date();\nconst daysLeft = Math.ceil((expiresAt - now) / (1000 * 60 * 60 * 24));\n\nlet message = '';\nlet emoji = '';\n\nif (daysLeft <= 1) {\n  emoji = '🔴';\n  message = `${emoji} *Подписка истекает сегодня!*\\n\\n`;\n  message += `Ваша подписка NeuroGUARDIAN заканчивается через ${daysLeft} день.\\n\\n`;\n  message += `⚠️ После окончания подписки:\\n`;\n  message += `• Сторож перестанет защищать ваши цены\\n`;\n  message += `• AI-агент будет недоступен\\n`;\n  message += `• Синхронизация товаров остановится\\n\\n`;\n  message += `💡 Продлите подписку прямо сейчас, чтобы не потерять защиту!`;\n} else if (daysLeft <= 3) {\n  emoji = '🟡';\n  message = `${emoji} *Подписка заканчивается через ${daysLeft} дня*\\n\\n`;\n  message += `Не забудьте продлить подписку NeuroGUARDIAN!\\n\\n`;\n  message += `Ваши товары под защитой ещё ${daysLeft} дня.\\n\\n`;\n  message += `Продлите сейчас со скидкой 10% по промокоду: RENEW10`;\n}\n\nreturn {\n  json: {\n    telegram_id: user.telegram_id,\n    message: message,\n    days_left: daysLeft,\n    expires_at: user.expires_at\n  }\n};"
      },
      "id": "code-1",
      "name": "Build Notification Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.telegram_id }}\",\n  \"text\": \"{{ $json.message }}\",\n  \"parse_mode\": \"Markdown\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [[\n      {\n        \"text\": \"💳 Продлить подписку\",\n        \"web_app\": {\n          \"url\": \"{{ $('Configuration').first().json.apiBaseUrl.replace('/api', '') }}\"\n        }\n      }\n    ]]\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "telegram-1",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        400,
        400
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "notifications",
        "include": "allFields"
      },
      "id": "aggregate-1",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        600,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst totalSent = items.length;\n\nconst message = `📬 *Notification Report*\\n\\n✅ Sent: ${totalSent} reminders\\n\\nUsers notified about expiring subscriptions.`;\n\nreturn {\n  json: {\n    message: message,\n    total_sent: totalSent\n  }\n};"
      },
      "id": "code-2",
      "name": "Build Admin Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Configuration').first().json.adminChatId }}\",\n  \"text\": \"{{ $json.message }}\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "telegram-2",
      "name": "Notify Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1000,
        400
      ]
    }
  ],
  "connections": {
    "Every 12 Hours": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "Get Expiring Subscriptions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Expiring Subscriptions": {
      "main": [
        [
          {
            "node": "Has Expiring Subscriptions?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Expiring Subscriptions?": {
      "main": [
        [
          {
            "node": "Split Users",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Users": {
      "main": [
        [
          {
            "node": "Build Notification Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Notification Message": {
      "main": [
        [
          {
            "node": "Send Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram Notification": {
      "main": [
        [
          {
            "node": "Aggregate Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Results": {
      "main": [
        [
          {
            "node": "Build Admin Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Admin Summary": {
      "main": [
        [
          {
            "node": "Notify Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
