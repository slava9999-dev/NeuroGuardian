{
  "name": "NeuroGUARDIAN Health Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "monitor-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -800,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "apiBaseUrl",
              "value": "={{ $env.API_URL }}",
              "type": "string"
            },
            {
              "id": "id-2",
              "name": "telegramBotToken",
              "value": "={{ $env.TELEGRAM_BOT_TOKEN }}",
              "type": "string"
            },
            {
              "id": "id-3",
              "name": "adminChatId",
              "value": "={{ $env.ADMIN_CHAT_ID }}",
              "type": "string"
            },
            {
              "id": "id-cron",
              "name": "cronSecret",
              "value": "={{ $env.CRON_SECRET }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all",
        "options": {}
      },
      "id": "monitor-config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -580,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=get-system-metrics",
        "authentication": "none",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            }
          ]
        }
      },
      "id": "health-check",
      "name": "API Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -360,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const metricsResult = $input.first()?.json || {};\n\nconst issues = [];\nlet status = 'healthy';\n\n// Check API health\nif (!metricsResult.success) {\n  issues.push('❌ API не отвечает');\n  status = 'critical';\n}\n\n// Check expiring subscriptions\nconst expiringCount = metricsResult.metrics?.subscriptions?.expiring_soon?.length || 0;\nif (expiringCount > 0) {\n  issues.push(`⚠️ Истекает подписок: ${expiringCount}`);\n  if (status === 'healthy') status = 'warning';\n}\n\n// Check Sentinel errors\nconst sentinelErrors = metricsResult.metrics?.sentinel?.errors_last_hour || 0;\nif (sentinelErrors > 10) {\n  issues.push(`⚠️ Sentinel ошибок за час: ${sentinelErrors}`);\n  if (status === 'healthy') status = 'warning';\n}\n\nlet message = '';\nif (status === 'healthy') {\n  message = `✅ *NeuroGUARDIAN Health Report*\\\\n\\\\n` +\n    `🟢 API: Работает\\\\n` +\n    `🛡️ Sentinel: OK\\\\n` +\n    `📊 Подписки: OK\\\\n` +\n    `⏰ ${new Date().toLocaleString('ru-RU')}`;\n} else {\n  message = `⚠️ *NeuroGUARDIAN Alert*\\\\n\\\\n` +\n    `Status: ${status.toUpperCase()}\\\\n\\\\n` +\n    `Проблемы:\\\\n${issues.join('\\\\n')}\\\\n\\\\n` +\n    `⏰ ${new Date().toLocaleString('ru-RU')}`;\n}\n\nreturn {\n  json: {\n    status: status,\n    issues: issues,\n    message: message,\n    shouldNotify: status !== 'healthy',\n    metricsResult: metricsResult\n  }\n};"
      },
      "id": "analyze-health",
      "name": "Analyze Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.shouldNotify }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "should-notify",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        140,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Configuration').first().json.adminChatId }}\",\n  \"text\": \"{{ $json.message }}\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-notification",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        360,
        200
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "status",
              "value": "all_healthy_no_notification",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "all-good",
      "name": "All Good",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        360,
        400
      ]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "API Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "API Health Check": {
      "main": [
        [
          {
            "node": "Analyze Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Health": {
      "main": [
        [
          {
            "node": "Should Notify?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Notify?": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "All Good",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}