{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@neuroguardian/security-agent": ["./security-agent/src/index.ts"]
    }
  },
  "include": ["api/**/*", "src/api-lib/**/*", "src/core/**/*", "src/sentinel/**/*", "src/agent/**/*", "src/infrastructure/**/*"],
  "references": [
    { "path": "./security-agent" }
  ]
}
