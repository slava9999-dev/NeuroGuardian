      "id": "ops-config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -780,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse command from webhook or heartbeat\nconst input = $input.first().json;\nlet command = 'heartbeat';\nlet params = {};\n\nif (input.body) {\n  // From webhook\n  const text = input.body.message?.text || '';\n  const parts = text.split(' ');\n  command = parts[0]?.replace('/', '') || 'status';\n  params = { args: parts.slice(1) };\n} else if (input.command) {\n  // Direct call\n  command = input.command;\n  params = input.params || {};\n}\n\nreturn [{ json: {\n    command: command,\n    params: params,\n    timestamp: new Date().toISOString(),\n    source: input.body ? 'webhook' : 'scheduler'\n  }}];"
      },
      "id": "parse-command",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
