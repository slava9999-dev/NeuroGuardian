            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"telegramId\": \"{{ $('Configuration').first().json.adminTelegramId }}\",\n  \"marketplace\": \"Ozon\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "sync-ozon",
      "name": "Sync Ozon Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -360,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=sync-products",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            },
            {
              "name": "X-Telegram-Id",
              "value": "={{ $('Configuration').first().json.adminTelegramId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"telegramId\": \"{{ $('Configuration').first().json.adminTelegramId }}\",\n  \"marketplace\": \"WB\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "sync-wb",
      "name": "Sync WB Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -140,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Get results from both Ozon and WB syncs\nconst ozonResult = $('Sync Ozon Products').first()?.json || {};\nconst wbResult = $input.first()?.json || {};\n\n// API returns 'count' field for synced products\nconst ozonSynced = ozonResult.count || ozonResult.synced || 0;\nconst wbSynced = wbResult.count || wbResult.synced || 0;\n\n// Check for errors (error field or non-success response)\nconst ozonError = ozonResult.error || (!ozonResult.success && ozonResult.count === undefined);\nconst wbError = wbResult.error || (!wbResult.success && wbResult.count === undefined);\nconst hasErrors = ozonError || wbError;\n\n// Build detailed error info\nlet errorDetails = '';\nif (ozonError && typeof ozonResult.error === 'string') {\n  errorDetails += `\\n❌ Ozon: ${ozonResult.error}`;\n  if (ozonResult.details) errorDetails += ` (${ozonResult.details.substring(0, 100)})`;\n}\nif (wbError && typeof wbResult.error === 'string') {\n  errorDetails += `\\n❌ WB: ${wbResult.error}`;\n  if (wbResult.details) errorDetails += ` (${wbResult.details.substring(0, 100)})`;\n}\n\nconst message = `📦 Sync Complete\\n\\n` +\n  `🔵 Ozon: ${ozonSynced} товаров` + (ozonError ? ' ❌' : ' ✅') + `\\n` +\n  `🟣 WB: ${wbSynced} товаров` + (wbError ? ' ❌' : ' ✅') +\n  (hasErrors ? errorDetails : '') + `\\n` +\n  `⏰ ${new Date().toLocaleString('ru-RU')}`;\n\nreturn [{ json: {\n    ozonSynced: ozonSynced,\n    wbSynced: wbSynced,\n    hasErrors: !!hasErrors,\n    ozonError: ozonError ? (ozonResult.error || 'Unknown') : null,\n    wbError: wbError ? (wbResult.error || 'Unknown') : null,\n    message: message\n  }}];"
      },
      "id": "build-summary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.hasErrors }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-errors",
