    {
      "parameters": {
        "jsCode": "// Build context for AI Agent\nconst userMessage = $('Parse Telegram Message').first().json;\nconst metrics = $('Get System Metrics').first().json || {};\nconst analytics = $input.first().json?.analytics || {};\n\nconst systemContext = {\n  timestamp: new Date().toISOString(),\n  api_status: metrics.success ? 'healthy' : 'error',\n  subscriptions: {\n    active: analytics.subscriptions?.active || 0,\n    expiring_soon: analytics.subscriptions?.expiring_soon || 0\n  },\n  sentinel: {\n    total_actions: analytics.sentinel?.total_actions || 0,\n    success_rate: analytics.sentinel?.success_rate || 0,\n    errors_last_hour: metrics.metrics?.sentinel?.errors_last_hour || 0\n  },\n  products: {\n    protected: analytics.products?.total_protected || 0,\n    users_with_protection: analytics.products?.users_with_protection || 0\n  },\n  money_saved: analytics.money_saved?.total_rub || 0\n};\n\nreturn [{ json: {\n    userMessage: userMessage.text,\n    chatId: userMessage.chatId,\n    username: userMessage.username,\n    systemContext: systemContext\n  }}];"
      },
