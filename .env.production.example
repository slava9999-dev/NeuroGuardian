# ============================================
# NeuroGUARDIAN Production Environment
# ПОЛНЫЙ БОЕВОЙ РЕЖИМ
# ============================================

# =====================================
# 🔐 ОБЯЗАТЕЛЬНЫЕ ДЛЯ PRODUCTION
# =====================================

# Telegram Bot Token (получить у @BotFather)
# Обязателен для криптографической валидации initData
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# YooKassa Credentials (Самозанятый)
# Получить в личном кабинете: https://yookassa.ru/my
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxx

# Admin Key (для init-db и admin endpoints)
# Генерировать: openssl rand -hex 32
ADMIN_API_KEY=your-secure-admin-key-here

# Vercel Cron Secret (автоматически генерируется Vercel)
CRON_SECRET=your-cron-secret

# =====================================
# 📍 ОПЦИОНАЛЬНЫЕ
# =====================================

# WebApp URL (для return_url после оплаты)
WEBAPP_URL=https://neuro-guardian.vercel.app

# Telegram Bot Username (для реферальных ссылок)
TELEGRAM_BOT_USERNAME=NeuroGuardianBot

# =====================================
# 💳 НАСТРОЙКА YOOKASSA ДЛЯ САМОЗАНЯТОГО
# =====================================

# 1. Зарегистрируйтесь на yookassa.ru
# 2. Подключите магазин как самозанятый (НПД):
#    - ФИО: Дерябин Вячеслав Валерьевич
#    - ИНН: 670301543202
#    - Статус: Самозанятый
# 3. Укажите URL для уведомлений (webhook):
#    https://neuro-guardian.vercel.app/api?action=payment-webhook
# 4. Включите способы оплаты:
#    - Банковская карта ✅
#    - СБП ✅
#    - ЮMoney ✅
#    - SberPay ✅
# 5. Скопируйте Shop ID и Secret Key в переменные выше

# =====================================
# ⚠️ ВАЖНО: ЮРИДИЧЕСКАЯ ИНФОРМАЦИЯ
# =====================================

# Для приёма платежей самозанятым требуется:
# ✅ Публичная оферта (договор с пользователем)
# ✅ Политика конфиденциальности 
# ✅ Контактные данные (email, телефон)
# ✅ ИНН и статус самозанятого
# ✅ Описание услуг и тарифов
#
# Всё это реализовано в приложении:
# - src/pages/LegalPage.tsx — полная юридическая информация
# - В приложении кнопка "Инфо" в нижней навигации

# =====================================
# 🔒 БЕЗОПАСНОСТЬ
# =====================================

# НЕ КОММИТЬТЕ этот файл с реальными ключами!
# Добавьте переменные через:
# - Vercel Dashboard → Settings → Environment Variables
# - Или через CLI: vercel env add TELEGRAM_BOT_TOKEN production

# =====================================
# 🚀 VERCEL ENVIRONMENT VARIABLES
# =====================================

# Добавьте в Vercel Dashboard (Settings → Environment Variables):
#
# Production:
# - TELEGRAM_BOT_TOKEN
# - YOOKASSA_SHOP_ID
# - YOOKASSA_SECRET_KEY
# - ADMIN_API_KEY
# - CRON_SECRET (автоматически)
# - WEBAPP_URL
#
# Preview/Development (опционально):
# - Можно не устанавливать — будет работать в тестовом режиме
