# NeuroGUARDIAN Cloud Functions Environment Variables
# Set these in Firebase console or via CLI

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CloudPayments Credentials
CLOUDPAYMENTS_PUBLIC_ID=your-public-id
CLOUDPAYMENTS_API_SECRET=your-api-secret

# Google Cloud
GOOGLE_CLOUD_PROJECT=neuroguardian
FUNCTIONS_REGION=us-central1

# Cloud Tasks
TASKS_QUEUE_NAME=sentinel-worker-queue
WORKER_FUNCTION_URL=https://us-central1-neuroguardian.cloudfunctions.net/sentinelWorker
