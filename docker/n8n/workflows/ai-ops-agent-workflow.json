        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Parse Telegram Message').first().json.chatId }}\",\n  \"text\": \"⛔ Доступ запрещен. Этот бот доступен только администраторам.\"\n}",
        "options": {
