      "id": "d5c01077-d709-4581-b5c5-b2dc5501b0c4",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        240,
        1344
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\n\nlet successCount = 0;\nlet errorCount = 0;\nlet validationFailedCount = 0;\nconst successProducts = [];\nconst errorProducts = [];\n\nfor (const item of items) {\n  const status = item.json.execution_status;\n  const marketplace = item.json.marketplace || 'unknown';\n  const productId = item.json.product_id || item.json.offer_id || 'unknown';\n  const action = item.json.defense_action || 'unknown';\n  \n  if (status === 'success') {\n    successCount++;\n    successProducts.push(`${marketplace.toUpperCase()}: ${productId} (${action})`);\n  } else if (status === 'validation_failed') {\n    validationFailedCount++;\n    errorProducts.push(`${marketplace.toUpperCase()}: ${productId} - Validation Failed`);\n  } else {\n    errorCount++;\n    const errorReason = item.json.error_reason || 'Unknown error';\n    errorProducts.push(`${marketplace.toUpperCase()}: ${productId} - ${errorReason}`);\n  }\n}\n\nlet message = `🛡️ *Defense System Report*\\n\\n`;\nmessage += `✅ Successful: ${successCount}\\n`;\nmessage += `❌ Failed: ${errorCount}\\n`;\nmessage += `⚠️ Validation Failed: ${validationFailedCount}\\n`;\nmessage += `📊 Total Processed: ${items.length}\\n\\n`;\n\nif (successProducts.length > 0) {\n  message += `*Successful Actions:*\\n`;\n  successProducts.forEach(p => message += `  • ${p}\\n`);\n  message += `\\n`;\n}\n\nif (errorProducts.length > 0) {\n  message += `*Failed Actions:*\\n`;\n  errorProducts.forEach(p => message += `  • ${p}\\n`);\n}\n\nreturn {\n  json: {\n    message: message,\n    successCount: successCount,\n    errorCount: errorCount,\n    validationFailedCount: validationFailedCount,\n    totalProcessed: items.length\n  }\n};"
      },
