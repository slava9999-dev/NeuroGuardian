        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Workflow Configuration').first().json.adminChatId }}\",\n  \"text\": \"⚠️ Unknown Defense Route\\n\\nMarketplace: {{ $json.marketplace }}\\nDefense Action: {{ $json.defense_action }}\\nProduct ID: {{ $json.product_id || $json.offer_id }}\\n\\nThis combination is not configured in the workflow.\",\n  \"parse_mode\": \"HTML\"\n}",
