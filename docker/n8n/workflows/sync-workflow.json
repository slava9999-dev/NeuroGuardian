{
  "name": "NeuroGUARDIAN Product Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 1
            }
          ]
        }
      },
      "id": "sync-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -800,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "apiBaseUrl",
              "value": "={{ $env.API_URL }}",
              "type": "string"
            },
            {
              "id": "id-2",
              "name": "cronSecret",
              "value": "={{ $env.CRON_SECRET }}",
              "type": "string"
            },
            {
              "id": "id-3",
              "name": "telegramBotToken",
              "value": "={{ $env.TELEGRAM_BOT_TOKEN }}",
              "type": "string"
            },
            {
              "id": "id-4",
              "name": "adminChatId",
              "value": "={{ $env.ADMIN_CHAT_ID }}",
              "type": "string"
            },
            {
              "id": "id-5",
              "name": "adminTelegramId",
              "value": "={{ $env.ADMIN_TELEGRAM_ID }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all",
        "options": {}
      },
      "id": "sync-config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=sync-products",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"telegramId\": \"{{ $('Configuration').first().json.adminTelegramId }}\",\n  \"marketplace\": \"Ozon\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "sync-ozon",
      "name": "Sync Ozon Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -360,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=sync-products",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"telegramId\": \"{{ $('Configuration').first().json.adminTelegramId }}\",\n  \"marketplace\": \"WB\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "sync-wb",
      "name": "Sync WB Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -140,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Get results from both Ozon and WB syncs\nconst ozonResult = $('Sync Ozon Products').first()?.json || {};\nconst wbResult = $input.first()?.json || {};\n\n// API returns 'count' field for synced products\nconst ozonSynced = ozonResult.count || ozonResult.synced || 0;\nconst wbSynced = wbResult.count || wbResult.synced || 0;\n\n// Check for errors (error field or non-success response)\nconst ozonError = ozonResult.error || (!ozonResult.success && ozonResult.count === undefined);\nconst wbError = wbResult.error || (!wbResult.success && wbResult.count === undefined);\nconst hasErrors = ozonError || wbError;\n\n// Build detailed error info\nlet errorDetails = '';\nif (ozonError && typeof ozonResult.error === 'string') {\n  errorDetails += `\\n❌ Ozon: ${ozonResult.error}`;\n  if (ozonResult.details) errorDetails += ` (${ozonResult.details.substring(0, 100)})`;\n}\nif (wbError && typeof wbResult.error === 'string') {\n  errorDetails += `\\n❌ WB: ${wbResult.error}`;\n  if (wbResult.details) errorDetails += ` (${wbResult.details.substring(0, 100)})`;\n}\n\nconst message = `📦 Sync Complete\\n\\n` +\n  `🔵 Ozon: ${ozonSynced} товаров` + (ozonError ? ' ❌' : ' ✅') + `\\n` +\n  `🟣 WB: ${wbSynced} товаров` + (wbError ? ' ❌' : ' ✅') +\n  (hasErrors ? errorDetails : '') + `\\n` +\n  `⏰ ${new Date().toLocaleString('ru-RU')}`;\n\nreturn {\n  json: {\n    ozonSynced: ozonSynced,\n    wbSynced: wbSynced,\n    hasErrors: !!hasErrors,\n    ozonError: ozonError ? (ozonResult.error || 'Unknown') : null,\n    wbError: wbError ? (wbResult.error || 'Unknown') : null,\n    message: message\n  }\n};"
      },
      "id": "build-summary",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.hasErrors }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-errors",
      "name": "Has Errors?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $('Configuration').first().json.adminChatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        },
        "options": {}
      },
      "id": "send-error-alert",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $('Configuration').first().json.adminChatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message }}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        },
        "options": {}
      },
      "id": "send-success-alert",
      "name": "Send Success Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        400
      ]
    }
  ],
  "connections": {
