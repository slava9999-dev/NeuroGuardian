{
  "name": "NeuroGUARDIAN Analytics Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "analytics-trigger",
      "name": "Daily at Midnight",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -800,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "apiBaseUrl",
              "value": "={{ $env.API_URL }}",
              "type": "string"
            },
            {
              "id": "id-2",
              "name": "cronSecret",
              "value": "={{ $env.CRON_SECRET }}",
              "type": "string"
            },
            {
              "id": "id-3",
              "name": "telegramBotToken",
              "value": "={{ $env.TELEGRAM_BOT_TOKEN }}",
              "type": "string"
            },
            {
              "id": "id-4",
              "name": "adminChatId",
              "value": "={{ $env.ADMIN_CHAT_ID }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all",
        "options": {}
      },
      "id": "analytics-config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -580,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuration').first().json.apiBaseUrl }}?action=get-analytics",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuration').first().json.cronSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "get-analytics",
      "name": "Get Analytics Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -360,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $input.first()?.json?.analytics || {};\n\nconst formatNumber = (num) => {\n  return new Intl.NumberFormat('ru-RU').format(num || 0);\n};\n\nconst formatMoney = (num) => {\n  return new Intl.NumberFormat('ru-RU', { style: 'currency', currency: 'RUB' }).format(num || 0);\n};\n\nconst message = `📊 *NeuroGUARDIAN — Ежедневный Отчёт*\\n\\n` +\n  `📅 Период: последние 24 часа\\n` +\n  `⏰ ${new Date().toLocaleString('ru-RU')}\\n\\n` +\n  `━━━━━━━━━━━━━━━━━━━━━━\\n\\n` +\n  `👥 *Подписки*\\n` +\n  `✅ Активных: ${formatNumber(data.subscriptions?.active)}\\n` +\n  `⚠️ Истекают скоро: ${formatNumber(data.subscriptions?.expiring_soon)}\\n\\n` +\n  `🛡️ *Защищённые товары*\\n` +\n  `📦 Всего: ${formatNumber(data.products?.total_protected)}\\n` +\n  `👤 Пользователей: ${formatNumber(data.products?.users_with_protection)}\\n` +\n  `💰 Средняя мин. цена: ${formatMoney(data.products?.avg_min_price)}\\n\\n` +\n  `⚡ *Sentinel (за 24ч)*\\n` +\n  `🔧 Всего действий: ${formatNumber(data.sentinel?.total_actions)}\\n` +\n  `💵 Корректировок цен: ${formatNumber(data.sentinel?.price_corrections)}\\n` +\n  `📉 Обнулений остатков: ${formatNumber(data.sentinel?.zero_stocks)}\\n` +\n  `✅ Успешных: ${formatNumber(data.sentinel?.successful)}\\n` +\n  `❌ Ошибок: ${formatNumber(data.sentinel?.failed)}\\n` +\n  `📈 Success Rate: ${data.sentinel?.success_rate || 0}%\\n\\n` +\n  `💸 *Сохранено денег*\\n` +\n  `${formatMoney(data.money_saved?.total_rub)}\\n\\n` +\n  `👥 *Активность*\\n` +\n  `Активных пользователей: ${formatNumber(data.users?.active_last_24h)}\\n\\n` +\n  `━━━━━━━━━━━━━━━━━━━━━━`;\n\nreturn {\n  json: {\n    message: message,\n    hasData: !!data.timestamp,\n    analytics: data\n  }\n};"
      },
      "id": "build-report",
      "name": "Build Report Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "id-1",
              "leftValue": "={{ $json.hasData }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-data",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        80,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Configuration').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Configuration').first().json.adminChatId }}\",\n  \"text\": \"{{ $json.message }}\",\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-report",
      "name": "Send Report to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        300,
        200
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "status",
              "value": "no_data_skip",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "no-data",
      "name": "No Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        400
      ]
    }
  ],
  "connections": {
    "Daily at Midnight": {
      "main": [
        [
          {
            "node": "Configuration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuration": {
      "main": [
        [
          {
            "node": "Get Analytics Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Analytics Data": {
      "main": [
        [
          {
            "node": "Build Report Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Report Message": {
      "main": [
        [
          {
            "node": "Has Data?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Data?": {
      "main": [
        [
          {
            "node": "Send Report to Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": true,
  "versionId": "1a367d15-1245-420b-a805-e1c0fbe5326f"
}