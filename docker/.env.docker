# ============================================
# Docker Environment Variables
# ============================================
# Копируйте в .env в директории docker/

# PostgreSQL
POSTGRES_USER=neuroguardian
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=neuroguardian_dev

# Redis
REDIS_PASSWORD=localredispass

# n8n
N8N_USER=admin
N8N_PASSWORD=localn8npass
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=change-this-to-32-char-key-here

# NeuroGuardian API
API_URL=http://host.docker.internal:3000
CRON_SECRET=dev-cron-secret
ADMIN_CHAT_ID=0
