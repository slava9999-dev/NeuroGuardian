# NeuroGUARDIAN Environment Variables
# =====================================

# Frontend (Vite)
# ----------------
# For local development, API routes are at /api
# For production, leave empty to use relative paths
VITE_API_BASE_URL=

# Firebase (OPTIONAL - only if using Firebase features)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Backend (Vercel)
# -----------------
# These should be set in Vercel Project Settings > Environment Variables

# Vercel Postgres (auto-set by Vercel when you add Postgres)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Telegram Bot
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# YooKassa Payment
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key

# Admin
# ADMIN_API_KEY=your_secret_admin_key

# API Key Encryption (REQUIRED for production - 32 character key)
# Generate with: openssl rand -hex 16
# API_KEY_ENCRYPTION_KEY=your_32_character_encryption_key

# Cron Job Secret (for Vercel Cron)
# CRON_SECRET=your_cron_secret

# Manual Admin Trigger Key
# ADMIN_KEY=your_admin_key

# Webapp URL (for payment return)
# WEBAPP_URL=https://your-app.vercel.app

# ============================================
# TEST MODE (for development/testing)
# ============================================
# Set to "true" to disable payment requirements
# All users will get Pro subscription features for free
# IMPORTANT: Set to "false" or remove for production!
# TEST_MODE=true

# ============================================
# AI AGENT (LLM Integration)
# ============================================
# Priority: AgentRouter > Groq > OpenAI

# Option 1: AgentRouter (RECOMMENDED - best value, GPT-4o access)
# Get your API key from https://agentrouter.org/console/token
# AGENTROUTER_API_KEY=your_agentrouter_key

# Option 2: Groq (fast, free tier but limited TPM)
# Get your API key from https://console.groq.com
# GROQ_API_KEY=gsk_your_groq_api_key

# Option 3: OpenAI (direct, requires billing)
# Get your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# Option 4: Web Search (Serper.dev)
# Get your API key from https://serper.dev
# SERPER_API_KEY=your_serper_api_key
