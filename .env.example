# ============================================
# NeuroGUARDIAN Environment Variables
# ============================================
# Версия: 2.0.0
# Обновлено: 2025-12-29
#
# Инструкция:
# 1. Скопируйте этот файл как .env.local
# 2. Заполните обязательные переменные
# 3. Никогда не коммитьте .env.local в git!

# ============================================
# РЕЖИМ РАБОТЫ
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# FRONTEND (Vite)
# ============================================
# DEV MODE: Включает режим разработки без Telegram
# ⚠️ НИКОГДА не включайте в production!
VITE_DEV_MODE=false

# URL API для локальной разработки
VITE_API_BASE_URL=

# URL приложения
VITE_APP_URL=http://localhost:3000

# ============================================
# БАЗА ДАННЫХ (PostgreSQL)
# ============================================
# Локальная разработка (Docker)
POSTGRES_USER=neuroguardian
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=neuroguardian_dev
DATABASE_URL=postgresql://neuroguardian:localdevpassword@localhost:5432/neuroguardian_dev

# Production (Neon Serverless)
# Получить: https://console.neon.tech
# POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require

# ============================================
# REDIS (для кэширования)
# ============================================
REDIS_PASSWORD=localredispass
REDIS_URL=redis://:localredispass@localhost:6379

# ============================================
# N8N (автоматизация)
# ============================================
N8N_USER=admin
N8N_PASSWORD=localn8npass
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
# Ключ шифрования (32 символа)
N8N_ENCRYPTION_KEY=change-this-to-32-char-key-here

# ============================================
# TELEGRAM BOT
# ============================================
# Получить: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ID чата администратора (для уведомлений)
# ADMIN_CHAT_ID=your_telegram_user_id

# ============================================
# AI AGENT (LLM)
# ============================================
# Приоритет: AgentRouter > Groq > OpenAI > Google

# Option 1: AgentRouter (РЕКОМЕНДУЕТСЯ)
# Получить: https://agentrouter.org/console/token
# AGENTROUTER_API_KEY=your_agentrouter_key

# Option 2: Groq (быстро, бесплатный tier)
# Получить: https://console.groq.com
# GROQ_API_KEY=gsk_your_groq_api_key

# Option 3: OpenAI (напрямую)
# Получить: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# Option 4: Google Gemini
# Получить: https://makersuite.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_key

# ============================================
# МАРКЕТПЛЕЙСЫ
# ============================================
# Wildberries API
# Получить: https://seller.wildberries.ru/supplier-settings/access-to-api
# WB_API_TOKEN=your_wb_api_token

# Ozon API
# Получить: https://seller.ozon.ru/app/settings/api-keys
# OZON_CLIENT_ID=your_ozon_client_id
# OZON_API_KEY=your_ozon_api_key

# ============================================
# БЕЗОПАСНОСТЬ
# ============================================
# Ключ шифрования API ключей (32 символа)
# Генерация: openssl rand -hex 16
# API_KEY_ENCRYPTION_KEY=your_32_character_encryption_key

# Секрет для cron-заданий (n8n)
# CRON_SECRET=your_cron_secret

# API ключ администратора
# ADMIN_API_KEY=your_admin_api_key

# ============================================
# ПЛАТЕЖИ (YooKassa)
# ============================================
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key

# ============================================
# VERCEL (деплой)
# ============================================
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id

# URL приложения (для платежей и редиректов)
# WEBAPP_URL=https://your-app.vercel.app

# ============================================
# ТЕСТОВЫЙ РЕЖИМ
# ============================================
# Включает Pro-подписку для всех пользователей
# ⚠️ ОТКЛЮЧИТЕ в production!
# TEST_MODE=true

# ============================================
# ДОПОЛНИТЕЛЬНО
# ============================================
# Web Search (Serper.dev)
# Get your API key from https://serper.dev
# SERPER_API_KEY=your_serper_api_key

# Firebase (опционально)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
