# NeuroGUARDIAN Environment Variables
# =====================================

# Frontend (Vite)
# ----------------
# For local development, API routes are at /api
# For production, leave empty to use relative paths
VITE_API_BASE_URL=

# Firebase (OPTIONAL - only if using Firebase features)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Backend (Vercel)
# -----------------
# These should be set in Vercel Project Settings > Environment Variables

# Vercel Postgres (auto-set by Vercel when you add Postgres)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Telegram Bot
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# YooKassa Payment
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key

# Admin
# ADMIN_API_KEY=your_secret_admin_key

# API Key Encryption (REQUIRED for production - 32 character key)
# Generate with: openssl rand -hex 16
# API_KEY_ENCRYPTION_KEY=your_32_character_encryption_key

# Cron Job Secret (for Vercel Cron)
# CRON_SECRET=your_cron_secret

# Manual Admin Trigger Key
# ADMIN_KEY=your_admin_key

# Webapp URL (for payment return)
# WEBAPP_URL=https://your-app.vercel.app
