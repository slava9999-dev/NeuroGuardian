# NeuroGUARDIAN Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=neuroguardian.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neuroguardian
VITE_FIREBASE_STORAGE_BUCKET=neuroguardian.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Use Firebase Emulators in development
VITE_USE_EMULATORS=false

# API Base URL (Cloud Functions)
VITE_API_BASE_URL=https://us-central1-neuroguardian.cloudfunctions.net
