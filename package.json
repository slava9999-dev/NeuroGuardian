{
  "name": "neuroguardian",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npx tsx scripts/local-api-server.mjs",
    "dev:full": "concurrently \"npm run dev:api\" \"cross-env VITE_LOCAL_BACKEND=true npm run dev\"",
    "build": "vite build",
    "build:security-agent": "cd security-agent && npm run build",
    "vercel-build": "rm -rf api/handlers && npm run build:security-agent && npm run build -- --emptyOutDir",
    "postinstall": "cd security-agent && npm install && npm run build || true",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:regression": "node scripts/check-regression.cjs",
    "check:production": "node scripts/production-check.cjs",
    "check:all": "npm run lint && npm run typecheck && npm run build && npm run test && npm run check:regression",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "checklist": "node scripts/production-checklist.cjs",
    "pre-flight": "npx tsx scripts/ops/pre-flight.ts",
    "gen-key": "npx tsx scripts/ops/generate-key.ts",
    "docker:up": "cd docker && docker compose up -d",
    "docker:down": "cd docker && docker compose down",
    "docker:logs": "cd docker && docker compose logs -f",
    "docker:reset": "cd docker && docker compose down -v && docker compose up -d",
    "health": "powershell -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "n8n:export": "node scripts/n8n-export.mjs",
    "n8n:import": "node scripts/n8n-import.mjs",
    "n8n:import:activate": "node scripts/n8n-import.mjs --activate",
    "gpu:up": "cd docker/gpu && docker compose up -d",
    "gpu:down": "cd docker/gpu && docker compose down",
    "gpu:logs": "cd docker/gpu && docker compose logs -f",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3001/api/inngest",
    "test:agent": "npx tsx tests/agent/run-professional-tests.ts",
    "test:agent:pro": "npx tsx tests/agent/run-pro-tests.ts",
    "test:agent:local": "npx vitest run tests/agent/viktor-local-e2e.test.ts",
    "test:agent:verbose": "npx tsx tests/agent/run-professional-tests.ts --verbose",
    "test:agent:setup": "npx tsx tests/agent/run-professional-tests.ts --setup",
    "test:agent:cleanup": "npx tsx tests/agent/run-professional-tests.ts --cleanup",
    "medic": "npx tsx scripts/neuro-medic.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.46",
    "@aws-sdk/client-s3": "^3.969.0",
    "@aws-sdk/lib-storage": "^3.969.0",
    "@langchain/community": "^0.3.28",
    "@langchain/core": "^0.3.37",
    "@langchain/langgraph": "^0.2.45",
    "@langchain/openai": "^0.3.17",
    "@neuroguardian/security-agent": "file:security-agent",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@telegram-apps/sdk": "^2.11.3",
    "@upstash/qstash": "^2.8.4",
    "@vercel/kv": "^3.0.0",
    "@vercel/postgres": "^0.10.0",
    "ai": "^5.0.113",
    "axios": "^1.13.2",
    "bullmq": "^5.66.5",
    "canvas-confetti": "^1.9.4",
    "chromadb": "^1.10.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.23.26",
    "inngest": "^3.22.12",
    "lucide-react": "^0.562.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.6.0",
    "replicate": "^1.4.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.5.16",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.82.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "path-to-regexp": "^8.0.0",
    "undici": "^7.0.0",
    "esbuild": "^0.25.0",
    "diff": "^8.0.0"
  }
}
