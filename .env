# NeuroGUARDIAN Environment Variables
# =====================================

# API Base URL
# Оставьте пустым для Vercel (будет использоваться /api)
# Или укажите полный URL для локальной разработки
VITE_API_BASE_URL=

# ===========================================
# VERCEL ENVIRONMENT VARIABLES
# (Эти переменные нужно добавить в Vercel Dashboard)
# ===========================================

# Vercel Postgres (добавляется автоматически при создании БД)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Telegram Bot Token (получить от @BotFather)
# TELEGRAM_BOT_TOKEN=

# YooKassa Payment Credentials
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Admin API Key (для init-db и cron)
# ADMIN_API_KEY=

# Vercel Cron Secret
# CRON_SECRET=

ADMIN_KEY=neuro_secret_test_key
