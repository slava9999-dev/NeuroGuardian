{
  "name": "@neuroguardian/security-agent",
  "version": "1.0.0",
  "description": "Security Agent SDK for NeuroGUARDIAN - Secrets, Audit, AuthZ, and more",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./secrets": {
      "import": "./dist/secrets.js",
      "types": "./dist/secrets.d.ts"
    },
    "./audit": {
      "import": "./dist/audit.js",
      "types": "./dist/audit.d.ts"
    },
    "./authz": {
      "import": "./dist/authz.js",
      "types": "./dist/authz.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "vault:init": "node scripts/init-vault.cjs",
    "security:scan": "node scripts/scan-secrets.cjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.28.0",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "pino": "^8.17.2"
  },

  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "security",
    "vault",
    "secrets",
    "audit",
    "authorization"
  ],
  "author": "NeuroGUARDIAN Team",
  "license": "MIT"
}
