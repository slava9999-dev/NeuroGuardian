# Security Agent Configuration
# =============================
# Copy this file to .env and fill in real values

# ============================================
# HashiCorp Vault
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token
# VAULT_NAMESPACE=
VAULT_TLS_ENABLED=false

# ============================================
# ClickHouse (Audit Logs)
# ============================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=security_audit
CLICKHOUSE_USER=security_agent
CLICKHOUSE_PASSWORD=secure_password_change_me

# ============================================
# Redis (Policy Cache)
# ============================================
# Option 1: Upstash Redis (for production)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Option 2: Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me

# ============================================
# Security Settings
# ============================================
# HMAC signing key for audit logs (generate with: openssl rand -hex 32)
SECURITY_SIGNING_KEY=change-this-in-production-64-char-hex-key

# Enable leak detection (recommended: true)
ENABLE_LEAK_DETECTION=true

# Permissive mode - allows operations even if security checks fail
# Use only for initial testing, MUST be false in production!
SECURITY_PERMISSIVE_MODE=false

# ============================================
# Grafana (Monitoring)
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password_change_me

# ============================================
# S3 Backup (Optional - for audit log backup)
# ============================================
# S3_BUCKET_NAME=neuroguardian-audit-backup
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
