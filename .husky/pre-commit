#!/usr/bin/env bash
# ============================================
# Pre-commit hook - Regression Prevention
# ============================================
# Uses consolidated check script to avoid DRY violations
# All check logic lives in scripts/check-regression.cjs
# ============================================

# Step 0: Secret Scanning (SECURITY AGENT)
echo ""
echo "🔐 Running secret scan..."
if [ -f "security-agent/scripts/scan-secrets.cjs" ]; then
  # Get list of staged files
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|json)$' | tr '\n' ' ')
  if [ -n "$STAGED_FILES" ]; then
    node security-agent/scripts/scan-secrets.cjs $STAGED_FILES
    if [ $? -ne 0 ]; then
      echo "❌ Secret scan failed! Please remove secrets and use Vault."
      exit 1
    fi
  fi
  echo "✅ No secrets detected in staged files"
fi

# Step 1: Run lint-staged (auto-format staged files)
npx lint-staged

# Step 2: Run consolidated regression checks
# This uses the same script as CI, ensuring consistency
echo ""
echo "🔍 Running policy checks (pre-commit)..."
npm run check:regression

